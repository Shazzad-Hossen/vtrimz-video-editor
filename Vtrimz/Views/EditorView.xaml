<UserControl x:Class="Vtrimz.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:controls="clr-namespace:Vtrimz.Controls"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video player -->
        <Border Grid.Row="0"
                Background="Black"
                Margin="0"
                ClipToBounds="True"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <vlc:VideoView x:Name="VideoView"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Background="Black"/>
        </Border>

        <!-- Playback controls -->
        <Border Grid.Row="1"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevFrameButton" Content="&#xE892;" Style="{StaticResource IconButton}" ToolTip="Previous Frame" Click="PrevFrameButton_Click"/>
                    <Button x:Name="PlayPauseButton" Content="&#xE768;" Style="{StaticResource IconButton}" Margin="6,0" ToolTip="Play / Pause" Click="PlayPauseButton_Click"/>
                    <Button x:Name="NextFrameButton" Content="&#xE893;" Style="{StaticResource IconButton}" ToolTip="Next Frame" Click="NextFrameButton_Click"/>
                </StackPanel>

                <TextBlock x:Name="TimeDisplay"
                           Grid.Column="1"
                           Text="00:00.00 / 00:00.00"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Consolas"
                           FontSize="13"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE767;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider"
                            Width="100"
                            Minimum="0"
                            Maximum="100"
                            Value="80"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Timeline -->
        <controls:TimelineControl x:Name="Timeline"
                                  Grid.Row="2"
                                  MinHeight="200"
                                  PositionChanged="Timeline_PositionChanged"
                                  ScreenshotRequested="Timeline_ScreenshotRequested"/>
    </Grid>
</UserControl>
