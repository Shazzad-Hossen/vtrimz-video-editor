<UserControl x:Class="Vtrimz.Controls.TimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPanelBrush}"
             MinHeight="160"
             Focusable="True"
             PreviewKeyDown="TimelineControl_PreviewKeyDown"
             PreviewMouseMove="TimelineControl_PreviewMouseMove"
             PreviewMouseLeftButtonUp="TimelineControl_PreviewMouseLeftButtonUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BgElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="UndoButton" Content="&#xE7A7;" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="UndoButton_Click" IsEnabled="False" ToolTip="Undo (Ctrl+Z)"/>
                <Button x:Name="RedoButton" Content="&#xE7A6;" Style="{StaticResource IconButton}" Margin="0,0,8,0" Click="RedoButton_Click" IsEnabled="False" ToolTip="Redo (Ctrl+Y)"/>
                <Button x:Name="SplitButton" Content="Split" Style="{StaticResource EditorButton}" Margin="0,0,4,0" Click="SplitButton_Click"/>
                <Button x:Name="DeleteButton" Content="Delete Clip" Style="{StaticResource EditorButton}" Margin="0,0,8,0" Click="DeleteButton_Click" IsEnabled="False" ToolTip="Delete selected clip (Del)"/>
                <Button x:Name="ZoomOutButton" Content="&#xE71F;" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="ZoomOutButton_Click" ToolTip="Zoom Out (Ctrl+Wheel)"/>
                <Button x:Name="ZoomInButton" Content="&#xE8A3;" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="ZoomInButton_Click" ToolTip="Zoom In (Ctrl+Wheel)"/>
                <Button x:Name="FitButton" Content="Fit" Style="{StaticResource EditorButton}" Margin="0,0,8,0" Click="FitButton_Click" ToolTip="Fit full timeline to window"/>
                <Button x:Name="ScreenshotButton" Content="&#xE722;" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="ScreenshotButton_Click" ToolTip="Screenshot"/>
                <TextBlock x:Name="ZoomLabel"
                           Text="100%"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="12"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="TimelineScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Background="{StaticResource BgPanelBrush}"
                      PreviewMouseWheel="TimelineScroll_PreviewMouseWheel">
            <Canvas x:Name="TimelineCanvas"
                    Background="Transparent"
                    MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                    MouseMove="TimelineCanvas_MouseMove"
                    MouseLeave="TimelineCanvas_MouseLeave">
                <Canvas x:Name="RulerLayer"/>
                <Canvas x:Name="TracksLayer"/>
                <Canvas x:Name="ClipsLayer" Panel.ZIndex="90"/>
                <Canvas x:Name="MarkerLayer" Panel.ZIndex="95">
                    <Rectangle x:Name="MarkerHitArea"
                               Fill="Transparent"
                               Cursor="Hand"
                               MouseLeftButtonDown="Marker_MouseLeftButtonDown"
                               MouseEnter="Marker_MouseEnter"
                               MouseLeave="Marker_MouseLeave"/>
                    <Line x:Name="MarkerLine"
                          Stroke="{StaticResource MarkerBrush}"
                          StrokeThickness="2"
                          IsHitTestVisible="False"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <Border x:Name="MarkerHead"
                            Width="22"
                            Height="16"
                            CornerRadius="4"
                            Background="{StaticResource MarkerBrush}"
                            BorderBrush="#FFFFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonDown="Marker_MouseLeftButtonDown"
                            MouseEnter="Marker_MouseEnter"
                            MouseLeave="Marker_MouseLeave"/>
                </Canvas>
            </Canvas>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource BgElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock x:Name="PositionLabel"
                       Text="00:00.00"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       FontFamily="Consolas"/>
        </Border>
    </Grid>
</UserControl>
